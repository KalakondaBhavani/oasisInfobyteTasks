<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <TextView
        android:id="@+id/display"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:text="0"
        android:textSize="45sp"
        android:textColor="#222"
        android:gravity="end|center_vertical"
        android:background="#fff"
        android:padding="20dp"
        android:fontFamily="sans-serif-medium"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="10dp">

        <!-- First row -->
        <Button android:id="@+id/btnC" android:text="C" android:textColor="#FFF"
            android:background="#FF7F50" android:textSize="22sp"/>
        <Button android:id="@+id/btnOpen" android:text="("  android:textColor="#FFF"
            android:background="#FFA500" android:textSize="22sp"/>
        <Button android:id="@+id/btnClose" android:text=")" android:textColor="#FFF"
            android:background="#FFA500" android:textSize="22sp"/>
        <Button android:id="@+id/btnDiv" android:text="/" android:textColor="#FFF"
            android:background="#2196F3" android:textSize="22sp"/>

        <!-- Second row -->
        <Button android:id="@+id/btn7" android:text="7" android:textColor="#FFF"
            android:background="#666" android:textSize="22sp"/>
        <Button android:id="@+id/btn8" android:text="8" android:textColor="#FFF"
            android:background="#666" android:textSize="22sp"/>
        <Button android:id="@+id/btn9" android:text="9" android:textColor="#FFF"
            android:background="#666" android:textSize="22sp"/>
        <Button android:id="@+id/btnMul" android:text="*" android:textColor="#FFF"
            android:background="#2196F3" android:textSize="22sp"/>

        <!-- Third row -->
        <Button android:id="@+id/btn4" android:text="4" android:textColor="#FFF"
            android:background="#666" android:textSize="22sp"/>
        <Button android:id="@+id/btn5" android:text="5" android:textColor="#FFF"
            android:background="#666" android:textSize="22sp"/>
        <Button android:id="@+id/btn6" android:text="6" android:textColor="#FFF"
            android:background="#666" android:textSize="22sp"/>
        <Button android:id="@+id/btnSub" android:text="-" android:textColor="#FFF"
            android:background="#2196F3" android:textSize="22sp"/>

        <!-- Fourth row -->
        <Button android:id="@+id/btn1" android:text="1" android:textColor="#FFF"
            android:background="#666" android:textSize="22sp"/>
        <Button android:id="@+id/btn2" android:text="2" android:textColor="#FFF"
            android:background="#666" android:textSize="22sp"/>
        <Button android:id="@+id/btn3" android:text="3" android:textColor="#FFF"
            android:background="#666" android:textSize="22sp"/>
        <Button android:id="@+id/btnAdd" android:text="+" android:textColor="#FFF"
            android:background="#2196F3" android:textSize="22sp"/>

        <!-- Fifth row -->
        <Button android:id="@+id/btnAC" android:text="AC" android:textColor="#FFF"
            android:background="#FF7F50" android:textSize="22sp"/>
        <Button android:id="@+id/btn0" android:text="0" android:textColor="#FFF"
            android:background="#666" android:textSize="22sp"/>
        <Button android:id="@+id/btnDot" android:text="." android:textColor="#FFF"
            android:background="#666" android:textSize="22sp"/>
        <Button android:id="@+id/btnEq" android:text="=" android:textColor="#FFF"
            android:background="#2196F3" android:textSize="22sp"/>
    </GridLayout>
</LinearLayout>